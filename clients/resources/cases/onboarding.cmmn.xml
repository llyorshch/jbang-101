<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL"
             xmlns:flowable="http://flowable.org/cmmn"
             xmlns:cmmndi="http://www.omg.org/spec/CMMN/20151109/CMMNDI"
             xmlns:dc="http://www.omg.org/spec/CMMN/20151109/DC"
             xmlns:di="http://www.omg.org/spec/CMMN/20151109/DI"
             targetNamespace="http://flywire.com/clients/cases">

  <case id="onboarding" name="Client onboarding">
    <casePlanModel id="onboardingPlanModel" name="Client onboarding" flowable:autoComplete="true">

      <planItem id="draftItem" name="Onboarding in draft" definitionRef="draft"/>
      <planItem id="openItem" name="Onboarding opened" definitionRef="open">
        <entryCriterion id="openEntryCriterion" sentryRef="onSubmitDraft"/>
        <exitCriterion id="openExitCriterion" sentryRef="onDecideToExitOpen"/>
      </planItem>
      <planItem id="finishedItem" name="Onboarding finished" definitionRef="finished">
        <entryCriterion id="finishedEntryCriterion" sentryRef="onDecideToFinish"/>
      </planItem>

      <sentry id="onSubmitDraft">
        <planItemOnPart id="onSubmitDraftPart" sourceRef="submitDraftItem">
          <standardEvent>complete</standardEvent>
        </planItemOnPart>
      </sentry>
      <sentry id="onDecideToExitOpen">
        <planItemOnPart id="onDecideToExitOpenPart" sourceRef="decideItem">
          <standardEvent>complete</standardEvent>
        </planItemOnPart>
      </sentry>
      <sentry id="onDecideToFinish">
        <planItemOnPart id="onDecideToFinishPart" sourceRef="decideItem">
          <standardEvent>complete</standardEvent>
        </planItemOnPart>
      </sentry>

      <!-- 1. Draft -->
      <stage id="draft" name="Onboarding in draft">
        <planItem id="submitDraftItem" name="Submit onboarding" definitionRef="submitDraft"/>
        <humanTask id="submitDraft" name="Submit onboarding"/>
      </stage>

      <!-- 2. Open: decision plus repeatable documentation / amendment loops -->
      <stage id="open" name="Onboarding opened">
        <planItem id="decideItem" name="Decide onboarding" definitionRef="decide"/>

        <planItem id="requestDocumentsItem" name="Request documents" definitionRef="requestDocuments">
          <itemControl>
            <repetitionRule id="requestDocumentsRepetition"/>
          </itemControl>
        </planItem>
        <planItem id="documentsRequiredItem" name="Documentation required" definitionRef="documentsRequired">
          <itemControl>
            <repetitionRule id="documentsRequiredRepetition"/>
          </itemControl>
          <entryCriterion id="documentsRequiredEntryCriterion" sentryRef="onRequestDocuments"/>
        </planItem>

        <planItem id="requestAmendmentItem" name="Request amendment" definitionRef="requestAmendment">
          <itemControl>
            <repetitionRule id="requestAmendmentRepetition"/>
          </itemControl>
        </planItem>
        <planItem id="amendmentRequiredItem" name="Amendment required" definitionRef="amendmentRequired">
          <itemControl>
            <repetitionRule id="amendmentRequiredRepetition"/>
          </itemControl>
          <entryCriterion id="amendmentRequiredEntryCriterion" sentryRef="onRequestAmendment"/>
        </planItem>

        <sentry id="onRequestDocuments">
          <planItemOnPart id="onRequestDocumentsPart" sourceRef="requestDocumentsItem">
            <standardEvent>occur</standardEvent>
          </planItemOnPart>
        </sentry>
        <sentry id="onRequestAmendment">
          <planItemOnPart id="onRequestAmendmentPart" sourceRef="requestAmendmentItem">
            <standardEvent>occur</standardEvent>
          </planItemOnPart>
        </sentry>

        <humanTask id="decide" name="Decide onboarding"/>
        <userEventListener id="requestDocuments" name="Request documents"/>
        <userEventListener id="requestAmendment" name="Request amendment"/>

        <stage id="documentsRequired" name="Documentation required">
          <planItem id="confirmDocumentsReceivedItem" name="Confirm documents received"
                    definitionRef="confirmDocumentsReceived"/>
          <humanTask id="confirmDocumentsReceived" name="Confirm documents received"/>
        </stage>

        <stage id="amendmentRequired" name="Amendment required">
          <planItem id="confirmAmendmentReceivedItem" name="Confirm amendment received"
                    definitionRef="confirmAmendmentReceived"/>
          <humanTask id="confirmAmendmentReceived" name="Confirm amendment received"/>
        </stage>
      </stage>

      <!-- 3. Finished: update the client and record the result as a milestone -->
      <stage id="finished" name="Onboarding finished" flowable:autoComplete="true">
        <planItem id="updateClientItem" name="Update client status" definitionRef="updateClient"/>
        <planItem id="onboardingSucceededItem" name="Onboarding succeeded" definitionRef="onboardingSucceeded">
          <entryCriterion id="onboardingSucceededEntryCriterion" sentryRef="whenApproved"/>
        </planItem>
        <planItem id="onboardingFailedItem" name="Onboarding failed" definitionRef="onboardingFailed">
          <entryCriterion id="onboardingFailedEntryCriterion" sentryRef="whenRejected"/>
        </planItem>

        <sentry id="whenApproved">
          <planItemOnPart id="whenApprovedPart" sourceRef="updateClientItem">
            <standardEvent>complete</standardEvent>
          </planItemOnPart>
          <ifPart id="whenApprovedIf">
            <condition><![CDATA[${outcome == 'APPROVED'}]]></condition>
          </ifPart>
        </sentry>
        <sentry id="whenRejected">
          <planItemOnPart id="whenRejectedPart" sourceRef="updateClientItem">
            <standardEvent>complete</standardEvent>
          </planItemOnPart>
          <ifPart id="whenRejectedIf">
            <condition><![CDATA[${outcome != 'APPROVED'}]]></condition>
          </ifPart>
        </sentry>

        <task id="updateClient" name="Update client status" isBlocking="false"
              flowable:type="java"
              flowable:expression="${clientLifecycle.onboardingFinished(caseInstance)}"/>
        <milestone id="onboardingSucceeded" name="Onboarding succeeded"/>
        <milestone id="onboardingFailed" name="Onboarding failed"/>
      </stage>
    </casePlanModel>
  </case>




